{
  "description": "Shared locators for common elements used across multiple components",
  "entries": {
    "closeButton": {
      "strategies": [
        { "type": "css", "selector": "button[aria-label*='Close'], button[aria-label*='close']", "confidence": 0.9 },
        { "type": "css", "selector": ".close-button, .btn-close", "confidence": 0.8 },
        { "type": "xpath", "selector": "//button[contains(@aria-label, 'Close')]", "confidence": 0.8 }
      ],
      "primary": "css"
    },
    "closeIcon": {
