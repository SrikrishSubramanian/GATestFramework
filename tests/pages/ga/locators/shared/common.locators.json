        { "type": "css", "selector": ".icon-close, .close-icon, svg[data-testid='close']", "confidence": 0.85 },
        { "type": "xpath", "selector": "//*[@class='close-icon' or @class='icon-close']", "confidence": 0.75 }
      ],
      "primary": "css"
    },
