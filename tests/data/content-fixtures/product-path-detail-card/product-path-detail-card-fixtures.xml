<?xml version="1.0" encoding="UTF-8"?>
<!-- Product Path Detail Card superscript fixture — the real style guide (GAAM-764/GAAM-859)
     authors <sup> markup on listItemDescription/featuredDescription fields but never on any
     title field (listItemTitle/descriptorTitle/ctaCalloutTitle), even though the dialog
     (_cq_dialog richtext fields) and HTL (rendered with @ context='html') both correctly
     support it there. This fixture adds one title-with-superscript instance so PPDC-010 has
     real content to exercise instead of self-skipping (GAAM-1269). -->
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/global-atlantic/settings/wcm/templates/ga-freeform-page"
        jcr:description="Product Path Detail Card superscript-title fixture (GAAM-1269)."
        jcr:primaryType="cq:PageContent"
        jcr:title="Product Path Detail Card — Superscript Title Fixture"
        sling:resourceType="ga/components/structure/page/basepage">
        <root jcr:primaryType="nt:unstructured">
            <main-par jcr:primaryType="nt:unstructured"
                sling:resourceType="ga/components/structure/semantic/main-wrapper">
                <card_superscript_title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="ga/components/content/product-path-detail-card"
                    headline="Maximize My Reliability"
                    imageElementType="imageOnly"
                    pathName="Path A"
                    subHeadline="&lt;p&gt;Guaranteed protection designed to keep pace with your financial goals.&lt;/p&gt;"
                    textIsRich="[true,true,true,true,true]">
                    <image
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="kkr-aem-base/components/content/image"
                        alt="Person reviewing financial documents"
                        fileReference="/content/dam/global-atlantic/style-guide/fpo-imagery/FPO-350x350.png"/>
                    <cta
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="kkr-aem-base/components/content/button"
                        linkTarget="_self"/>
                    <textElements jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            contentType="list"
                            listLabel="How it works">
                            <listItems jcr:primaryType="nt:unstructured">
                                <item0
                                    jcr:primaryType="nt:unstructured"
                                    listItemDescription="&lt;p&gt;Annual credited interest guaranteed for 10 years regardless of market performance.&lt;/p&gt;"
                                    listItemTitle="&lt;p&gt;Guaranteed Roll-up&lt;sup&gt;1&lt;/sup&gt;&lt;/p&gt;"/>
                            </listItems>
                            <button
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="kkr-aem-base/components/content/button"
                                linkTarget="_self"/>
                        </item0>
                    </textElements>
                </card_superscript_title>
            </main-par>
        </root>
    </jcr:content>
</jcr:root>
